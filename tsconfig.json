{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "allowJs": true
  },
  "include": [
    "src/**/*",
    "packages/**/*",
    "test/**/*",
    "*.ts",
    "*.js",
    "*.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
